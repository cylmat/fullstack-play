import { MongoClient } from "mongodb";
import { MongoDBAtlasVectorSearch } from "@langchain/mongodb";
import { OpenAIEmbeddings } from "@langchain/openai";
import { RecursiveCharacterTextSplitter } from "@langchain/textsplitters";
import { TextLoader } from "langchain/document_loaders/fs/text";
import path from "path";
import "dotenv/config"; // Charge vos variables d'environnement (MONGODB_URI, OPENAI_API_KEY)

// 1. Configuration
const client = new MongoClient(process.env.MONGODB_URI);
const dbName = "rag_database";
const collectionName = "knowledge_base";

async function run() {
  try {
    console.log("Connexion à MongoDB...");
    await client.connect();
    
    const db = client.db(dbName);
    const collection = db.collection(collectionName);

    // 2. Charger le fichier de données (Ex: un fichier markdown ou texte)
    console.log("Chargement du fichier...");
    const loader = new TextLoader(path.resolve("./data/document.txt"));
    const docs = await loader.load();

    // 3. Découper le texte en morceaux (Chunking)
    console.log("Découpage du texte en segments...");
    const splitter = new RecursiveCharacterTextSplitter({
      chunkSize: 1000,
      chunkOverlap: 200,
    });
    const splitDocs = await splitter.splitDocuments(docs);

    // 4. Initialiser le modèle d'embeddings d'OpenAI
    const embeddings = new OpenAIEmbeddings({
      modelName: "text-embedding-3-small", 
    });

    // 5. Stocker les documents et générer les vecteurs directement dans MongoDB
    console.log(`Importation de ${splitDocs.length} segments dans MongoDB...`);
    await MongoDBAtlasVectorSearch.fromDocuments(splitDocs, embeddings, {
      collection: collection,
      indexName: "vector_index", // Doit correspondre au nom de l'index Atlas
      textKey: "text",           // Champ où sera stocké le texte brut
      embeddingKey: "embedding", // Champ où sera stocké le tableau de vecteurs
    });

    console.log("Importation réussie ! Vos données sont prêtes pour le RAG.");
  } catch (error) {
    console.error("Erreur lors de l'ingestion :", error);
  } finally {
    await client.close();
  }
}

run();

```

