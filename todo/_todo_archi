Draw.io ou Diagrams.net 
---

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    openjdk-21-jre \
    graphviz \
    curl \
    wget \
    unzip \
    git \
    nodejs \
    npm \
    python3 \
    python3-pip \
    jq \
    findutils \
    grep \
    sed \
    vim \
    less \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# PlantUML
RUN curl -L -o /opt/plantuml.jar https://github.com/plantuml/plantuml/releases/latest/download/plantuml.jar

# Mermaid CLI
RUN npm install -g @mermaid-js/mermaid-cli

# Structurizr CLI
RUN curl -L -o /tmp/structurizr-cli.zip https://github.com/structurizr/cli/releases/latest/download/structurizr-cli.zip \
    && unzip /tmp/structurizr-cli.zip -d /opt/structurizr \
    && ln -s /opt/structurizr/structurizr.sh /usr/local/bin/structurizr \
    && chmod +x /usr/local/bin/structurizr \
    && rm /tmp/structurizr-cli.zip

WORKDIR /workspace

CMD ["/bin/bash"]

