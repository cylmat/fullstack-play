{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,

		//
		"allowJs": true,
		"checkJs": true,

		/* Preact Config */
		"jsx": "react-jsx", // Use the new JSX transform with preact-jsx-runtime
		"jsxImportSource": "preact", // options are: "preact", "react", "react-native"
		"skipLibCheck": true,
		"paths": {
			"react": ["./node_modules/preact/compat/"],
			"react-dom": ["./node_modules/preact/compat/"]
		}
	},
	"include": ["node_modules/vite/client.d.ts", "**/*"]
}
