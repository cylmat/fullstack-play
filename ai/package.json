{
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npm run dev:client & npm run dev:server",
		"dev:client": "vite --host 0.0.0.0 client",
		"dev:server": "node server/app.ts",
		"build": "npm run build:client && npm run build:server",
		"build:client": "tsc -b && vite build --config vite.client.config.ts",
		"build:server": "",
		"prettier": "npm run prettier:client & npm rnu prettier:server",
		"prettier:client": "prettier client",
		"prettier:server": "prettier server",
		"fix": "npm run fix:client & npm run fix:server",
		"fix:client": "prettier --write client",
		"fix:server": "prettier --write server",
		"preview": "vite preview",
		"stop": "pkill node & pkill npm",
		"test:server": "jest",
		"test": "npm run test:server"
	},
	"eslintConfig": {
		"extends": "preact"
	},
	"prettier": "./client/prettier.config.js",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.127.0",
		"@babel/preset-typescript": "^7.29.7",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"cors": "^2.8.6",
		"dotenv": "^18.0.1",
		"express": "^5.2.1",
		"lodash": "^4.18.1",
		"preact": "^10.29.8",
		"preact-iso": "^2.12.2",
		"preact-render-to-string": "^6.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@preact/preset-vite": "^2.10.6",
		"@types/express": "^5.0.6",
		"@types/lodash": "^4.17.25",
		"@types/node": "^22.20.3",
		"eslint": "^9.39.5",
		"eslint-config-preact": "^2.0.0",
		"jest": "^30.5.2",
		"preact-jsx-runtime": "^1.2.0",
		"prettier": "^3.9.8",
		"sass-embedded": "^1.104.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"yarn": "^1.22.22"
	},
	"workspaces": [
		"client",
		"server"
	]
}
