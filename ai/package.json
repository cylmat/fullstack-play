{
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npm run dev:client & npm run dev:server",
		"dev:client": "vite --host 0.0.0.0 client",
		"dev:server": "node server/app.ts --watch",
		"build": "npm run build:client && npm run build:server",
		"build:client": "tsc -b && vite build --config vite.client.config.ts",
		"build:server": "",
		"preview": "vite preview",
		"stop": "pkill node & pkill npm"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"express": "^5.2.1",
		"lodash": "^4.18.1",
		"preact": "^10.29.8",
		"preact-iso": "^2.12.2",
		"preact-render-to-string": "^6.7.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"@types/express": "^5.0.6",
		"@types/lodash": "^4.17.25",
		"@types/node": "^22.20.3",
		"eslint": "^9.39.5",
		"eslint-config-preact": "^2.0.0",
		"preact-jsx-runtime": "^1.2.0",
		"sass-embedded": "^1.104.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"yarn": "^1.22.22"
	},
	"eslintConfig": {
		"extends": "preact"
	},
	"workspaces": [
		"apps/client",
		"apps/server"
	]
}
