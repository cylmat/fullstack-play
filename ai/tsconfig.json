{
  // @doc https://www.typescriptlang.org/tsconfig/#compilerOptions
  "compilerOptions": {
    "allowImportingTsExtensions": true, // enable import from '...module/yyy.ts' "ts" extension
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["./server/*"] // allow name module instead of '../../modules' everywhere
    }
  }
}