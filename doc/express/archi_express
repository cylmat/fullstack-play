// src/models/user.model.js
class User {
  constructor({ id = null, email, name, createdAt = new Date() }) {
    if (!email) {
      throw new Error("L'email est obligatoire");
    }

    this.id = id;
    this.email = email;
    this.name = name;
    this.createdAt = createdAt;
  }

  toJSON() {
    return {
      id: this.id,
      email: this.email,
      name: this.name,
      createdAt: this.createdAt
    };
  }
}

module.exports = User;
```

