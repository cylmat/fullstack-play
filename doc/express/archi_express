// cache.manager.js
class CacheManager {
  constructor(redisClient) {
    this.redisClient = redisClient;
  }

  async get(key) {
    return this.redisClient.get(key);
  }

  async set(key, value, expiration) {
    return this.redisClient.set(key, value, {
      EX: expiration
    });
  }
}

module.exports = CacheManager;
```

